# Copy to .env and adjust as needed: cp .env.example .env
DJANGO_SECRET_KEY=change-me-to-a-random-string
DJANGO_DEBUG=1
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_TTL_SECONDS=300
MAX_UPLOAD_SIZE_BYTES=5242880
# REQUIRED. Base64 of exactly 32 random bytes (AES-256). Generate your own, never commit it:
#   python3 -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
# The placeholder below is intentionally invalid: Django will refuse to start with it.
STORAGE_ENCRYPTION_KEY=REPLACE_WITH_BASE64_32_BYTE_KEY
